package com.example.config;

import org.apache.commons.pool2.impl.GenericObjectPoolConfig;
import org.springframework.boot.autoconfigure.data.redis.RedisProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.redis.connection.RedisStandaloneConfiguration;
import org.springframework.data.redis.connection.lettuce.LettuceClientConfiguration;
import org.springframework.data.redis.connection.lettuce.LettuceConnectionFactory;
import org.springframework.data.redis.connection.lettuce.LettucePoolingClientConfiguration;

import java.time.Duration;

@Configuration
public class CustomRedisConfig {

    /**
     * 自定义 RedisConnectionFactory，覆盖 Spring Boot 默认的
     */
    @Bean
    public LettuceConnectionFactory redisConnectionFactory(RedisProperties redisProperties) {
        // 1. 创建 Redis 独立节点配置（单机模式）
        RedisStandaloneConfiguration config = new RedisStandaloneConfiguration();
        config.setHostName(redisProperties.getHost());
        config.setPort(redisProperties.getPort());
        
        // 设置密码（如果有的话）
        if (redisProperties.getPassword() != null && !redisProperties.getPassword().isEmpty()) {
            config.setPassword(redisProperties.getPassword());
        }

        // 2. 配置 Lettuce 客户端（含连接池）
        LettuceClientConfiguration clientConfig;
        
        if (redisProperties.getLettuce().getPool().isEnabled()) {
            // 启用连接池
            GenericObjectPoolConfig<?> poolConfig = new GenericObjectPoolConfig<>();
            RedisProperties.Pool poolProps = redisProperties.getLettuce().getPool();
            
            poolConfig.setMaxTotal(poolProps.getMaxActive());
            poolConfig.setMaxIdle(poolProps.getMaxIdle());
            poolConfig.setMinIdle(poolProps.getMinIdle());
            if (poolProps.getMaxWait() != null) {
                poolConfig.setMaxWaitMillis(poolProps.getMaxWait().toMillis());
            }

            clientConfig = LettucePoolingClientConfiguration.builder()
                    .commandTimeout(redisProperties.getTimeout())
                    .shutdownTimeout(Duration.ZERO) // 关闭时不等待
                    .poolConfig(poolConfig)
                    .build();
        } else {
            // 不使用连接池
            clientConfig = LettuceClientConfiguration.builder()
                    .commandTimeout(redisProperties.getTimeout())
                    .shutdownTimeout(Duration.ZERO)
                    .build();
        }

        // 3. 创建并返回 LettuceConnectionFactory
        return new LettuceConnectionFactory(config, clientConfig);
    }
}